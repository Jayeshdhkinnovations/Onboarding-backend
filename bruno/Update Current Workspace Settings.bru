meta {
  name: Update Current Workspace Settings
  type: http
  seq: 54
}

patch {
  url: {{base_url}}/api/workspaces/current
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Updated Acme Corp Workspace",
    "notificationPreferences": {
      "newResponseEmail": true,
      "weeklyDigestEmail": false,
      "productUpdatesEmail": true
    }
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.workspace: isDefined
}
