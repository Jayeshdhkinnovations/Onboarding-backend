meta {
  name: Get Current Workspace Settings
  type: http
  seq: 53
}

get {
  url: {{base_url}}/api/workspaces/current
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.workspace: isDefined
  res.body.workspace.notificationPreferences: isDefined
}
