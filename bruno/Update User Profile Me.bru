meta {
  name: Update User Profile Me
  type: http
  seq: 50
}

patch {
  url: {{base_url}}/api/users/me
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Jane Admin",
    "avatarUrl": "https://example.com/avatar.png"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.user: isDefined
  res.body.user.avatarUrl: isDefined
}
